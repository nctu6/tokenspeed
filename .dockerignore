# Skip pre-compiled kernel .so/.o files so they are rebuilt inside the container
**/*.so
**/*.o

# Common development artifacts
**/__pycache__
*.pyc
.git
*.nsys-rep
*.sqlite
*.egg-info

# Local Python virtualenvs -- never part of the build; a stray .venv at the
# repo root would otherwise be copied wholesale into the build context.
.venv
**/.venv

# Build output trees (Rust gateway, scheduler/kernel build dirs)
**/target
**/build
# Scratch folders (tokenspeed/tmp, DeepGEMM/tmp): mirrors, logs, benchmark
# output; never part of the build context.
tmp
**/tmp
