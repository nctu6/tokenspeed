# Build (from the repo root):
#   ./docker/unieai.nvidia.sh
#   # -> tags nctu6/tokenspeed:<short-commit>-<YYYYMMDD>  (Asia/Taipei date)
# Or manually:
#   docker build -f docker/Dockerfile.nvidia.unieai -t nctu6/tokenspeed:<hash>-<date> .
#
# UnieAI variant of Dockerfile.nvidia --------------------------------------
#
# Same build as Dockerfile.nvidia -- same base image and install order --
# widened to cover the sm_120 workstation tier. It is kept as a separate file,
# never an edit to Dockerfile.nvidia, for the reason UNIEINFRA.md gives: adding
# a file never conflicts on rebase, editing an upstream one conflicts on every
# rebase.
#
# What differs from Dockerfile.nvidia, and why:
#   1. CUDA_ARCH_LIST adds 12.0a (sm_120) to the datacenter 9.0a/10.0a, so one
#      image serves both tiers. Every kernel group builds for every listed
#      arch; attn_res's tcgen05 body is compiled only for sm_10x by a
#      __CUDA_ARCH__ guard in the source (stub on sm_90/sm_120), so ptxas never
#      sees tcgen05 for sm_120a.
#   2. Engine install uses the `diffusion` extra (./python[diffusion]) and an
#      explicit post-torchao reaffirm of diffusers/av/imageio-ffmpeg/soundfile,
#      mirroring scripts/install.sh so MiniMax-H3 (/v1/videos) and Music3
#      (/v1/audio/speech) work out of the box. Pure Python / wheels; no kernel
#      change.
#   3. FA2 (vLLM's flash-attention fork) is OPT-IN via WITH_FA2=1, matching
#      install.sh's --with-fa2. No engine/kernel code imports vllm_flash_attn
#      today and its top-level `flash_attn` package shadows FA4's
#      flash_attn.cute, so building it by default only wastes compile time.
#      When enabled, the collision guard backs it out and restores
#      tokenspeed-fa4 so flash_attn.cute survives.
#
# This file is SELF-CONTAINED: everything it installs lives in this repo's own
# build context (`COPY . /workspace`), so the image builds from a plain checkout
# with no out-of-tree sources. Keep smg/ populated in the context (submodule
# init'd) so the gateway is rebuilt from source.
#
# Build with buildx for linux/amd64 and linux/arm64. The base image is a
# multi-architecture manifest; prefer a native arm64 builder because QEMU
# emulation can make native extension builds substantially slower.
FROM lightseekorg/tokenspeed-runner:cu130-torch-2.13.0-flashinfer-0.6.18

USER root

ARG MAX_JOBS=16
# Fat binary spanning the datacenter tier (sm_90 Hopper, sm_100 Blackwell) and
# the workstation tier (sm_120, RTX PRO 6000 / 5090). Arch-only code is gated
# in the CUDA sources (attn_res tcgen05: sm_10x only), and setup.py keeps
# sm_12x arch-specific ("a"), which the NVFP4 kernels need, so this list
# compiles cleanly.
ARG CUDA_ARCH_LIST="9.0a 10.0a 12.0a"
# FlashAttention-2 from vLLM's fork: OPT-IN (WITH_FA2=1), default off -- same
# as scripts/install.sh (--with-fa2). Nothing in the engine or kernel imports
# vllm_flash_attn yet (sm_120 attention runs on FlashInfer FA2 / Triton), and
# the fork's top-level `flash_attn` package shadows FA4's flash_attn.cute, so a
# default build would compile it only to back it out. Pin a ref rather than
# tracking main when enabling it, so the build is reproducible.
ARG WITH_FA2=0
ARG VLLM_FLASH_ATTN_REPO="https://github.com/vllm-project/flash-attention"
ARG VLLM_FLASH_ATTN_REF="main"

ENV PIP_BREAK_SYSTEM_PACKAGES=1
# Kernel cuda.txt installs flashinfer-python==0.7.1rc2 (and upgrades torch to
# 2.14). The runner base ships an older flashinfer-jit-cache 0.6.18 whose API
# is incompatible (missing get_jit_cache_providers). Working host installs have
# no jit-cache package at all -- uninstall it before the kernel build. Serve
# scripts also export FLASHINFER_DISABLE_VERSION_CHECK=1; keep it for runtime.
ENV FLASHINFER_DISABLE_VERSION_CHECK=1

WORKDIR /workspace

# libnuma1 is required at runtime by torch_memory_saver, a TokenSpeed
# dependency. Install system dependencies before copying sources to preserve
# this cache layer across source-only changes.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        libssl-dev \
        libopenmpi-dev \
        libnuma1 \
        pkg-config && \
    rm -rf /var/lib/apt/lists/*

COPY . /workspace

# Install every TokenSpeed package from this checkout so the image always
# contains the source being built, rather than published package wheels.
#
# THE KERNEL MUST BE (RE)INSTALLED FROM SOURCE LAST. The engine (python/)
# declares `tokenspeed-kernel>=0.1.3.dev0` as a dependency, so
# `pip install "./python[diffusion]"` re-resolves it and OVERWRITES the source
# kernel we built in step 1 with an older published wheel (0.1.3). That wheel
# is missing symbols the engine imports, so the server dies at startup with e.g.
#   ImportError: cannot import name 'allgather_dual_rmsnorm'
#              from 'tokenspeed_kernel.ops.communication'
# Installing the engine first (letting it satisfy its many third-party deps --
# fastapi, grpcio, transformers, the tokenspeed-smg* stack, torch_memory_saver,
# plus the diffusion extra for H3/Music3), THEN reinstalling the local kernel
# and scheduler with --no-deps --force-reinstall, guarantees the source builds
# are the ones present in the final image. --force-reinstall overwrites the
# wheel pip pulled; --no-deps stops these two from dragging anything else back
# in.
#
# Engine uses the `diffusion` extra (non-editable in Docker; install.sh uses
# editable `./python[diffusion]`). After torchao, diffusion deps are reaffirmed
# explicitly -- same DEFAULT set as scripts/install.sh.
RUN python3 -m pip install cmake ninja && \
    python3 -m pip uninstall -y flashinfer-jit-cache || true && \
    MAX_JOBS=${MAX_JOBS} \
    FLASHINFER_CUDA_ARCH_LIST="${CUDA_ARCH_LIST}" \
    TOKENSPEED_KERNEL_BACKEND=cuda \
    python3 -m pip install tokenspeed-kernel/python/ --no-build-isolation && \
    python3 -m pip install tokenspeed-scheduler/ && \
    python3 -m pip install "./python[diffusion]" --no-build-isolation && \
    MAX_JOBS=${MAX_JOBS} \
    FLASHINFER_CUDA_ARCH_LIST="${CUDA_ARCH_LIST}" \
    TOKENSPEED_KERNEL_BACKEND=cuda \
    python3 -m pip install tokenspeed-kernel/python/ \
        --no-build-isolation --no-deps --force-reinstall && \
    python3 -m pip install tokenspeed-scheduler/ --no-deps --force-reinstall && \
    python3 -m pip install "torchao>=0.10.0" && \
    python3 -m pip install "diffusers>=0.40.0" av imageio-ffmpeg soundfile

# Optional (WITH_FA2=1): build vLLM's FlashAttention fork from source against
# this image's torch so the extension ABI matches. Clone with submodules
# (CUTLASS lives there) and install --no-build-isolation so it links the torch
# already in the image. Gencode follows CUDA_ARCH_LIST. Best-effort: never fail
# the image build on FA2.
#
# COLLISION GUARD. The fork installs a top-level `flash_attn` package that can
# shadow FA4's `flash_attn.cute` -- which tokenspeed_kernel imports. If
# flash_attn.cute no longer imports, back FA2 out AND restore tokenspeed-fa4
# (pip uninstall of the shared flash_attn/ dir also deletes FA4's cute/ files
# while leaving the dist recorded as installed).
RUN if [ "${WITH_FA2}" != "1" ]; then \
        echo "Skipping FA2 (vllm_flash_attn); opt in with --build-arg WITH_FA2=1"; \
    else \
        git clone --depth 1 --branch "${VLLM_FLASH_ATTN_REF}" --recursive \
            "${VLLM_FLASH_ATTN_REPO}" /tmp/vllm-flash-attention && \
        MAX_JOBS=${MAX_JOBS} \
        CUDA_HOME=/usr/local/cuda \
        CUDACXX=/usr/local/cuda/bin/nvcc \
        PATH="/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
        CUDA_ARCH_LIST="${CUDA_ARCH_LIST}" \
        TORCH_CUDA_ARCH_LIST="${CUDA_ARCH_LIST}" \
        python3 -m pip install /tmp/vllm-flash-attention --no-build-isolation --no-deps ; \
        rm -rf /tmp/vllm-flash-attention ; \
        if ! python3 -c "import flash_attn.cute" >/dev/null 2>&1; then \
            echo "WARN: vllm_flash_attn shadowed flash_attn.cute; removing FA2 and restoring tokenspeed-fa4"; \
            python3 -m pip uninstall -y vllm-flash-attn vllm_flash_attn >/dev/null 2>&1 || true; \
            python3 -m pip install --no-deps --force-reinstall tokenspeed-fa4 || true; \
            if python3 -c "import flash_attn.cute" >/dev/null 2>&1; then \
                echo "Restored FA4 flash_attn.cute after backing out FA2"; \
            else \
                echo "WARN: FA4 flash_attn.cute still missing after tokenspeed-fa4 reinstall"; \
            fi; \
        elif python3 -c "import vllm_flash_attn" >/dev/null 2>&1; then \
            echo "vllm_flash_attn OK and flash_attn.cute intact"; \
        else \
            echo "WARN: vllm_flash_attn not importable under that name"; \
        fi; \
    fi

# Build the smg OpenAI gateway (+ proto + servicer) from the vendored smg/
# source so the image carries local patches -- notably the best_of+stream
# validator fix in smg/crates/protocols. The base image ships the published
# tokenspeed-smg* wheels, which claim the same `smg` / `smg_grpc_proto` /
# `smg_grpc_servicer` import paths and would shadow the source build, so they
# are removed first. Recipe mirrors smg/scripts/installation/install-smg.sh: the
# OFFICIAL protoc release zip (NOT apt's protobuf-compiler -- that omits the
# well-known-type includes google/protobuf/{timestamp,struct}.proto the smg
# protos import, so codegen fails with "File not found"), a Rust toolchain, and
# maturin, then a release wheel built with vendored OpenSSL. Rust/protoc are
# build-only; no runtime footprint beyond the installed wheel.
RUN if [ -d smg/bindings/python ]; then \
        apt-get update && apt-get install -y --no-install-recommends \
            curl build-essential pkg-config unzip && \
        rm -rf /var/lib/apt/lists/* && \
        curl --proto '=https' --tlsv1.2 -fsSL -o /tmp/protoc.zip \
            https://github.com/protocolbuffers/protobuf/releases/download/v32.0/protoc-32.0-linux-x86_64.zip && \
        unzip -o /tmp/protoc.zip -d /usr/local && rm /tmp/protoc.zip && \
        protoc --version && \
        curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y && \
        # Hardcode /root: USER is root, and "$$HOME" is not reliably
        # unescaped by every docker builder (shell then expands $$ as PID ->
        # "1HOME/.cargo/env"). Matches rustup's default install prefix.
        . /root/.cargo/env && \
        python3 -m pip install "maturin>=1.0,<2.0" && \
        python3 -m pip uninstall -y \
            tokenspeed-smg tokenspeed-smg-grpc-proto tokenspeed-smg-grpc-servicer \
            smg smg-grpc-proto smg-grpc-servicer || true && \
        rm -rf smg/bindings/python/dist && \
        ( cd smg/bindings/python && \
          PROTOC=/usr/local/bin/protoc \
          maturin build --release --features vendored-openssl --out dist ) && \
        python3 -m pip install --force-reinstall smg/bindings/python/dist/*.whl && \
        python3 -m pip install smg/crates/grpc_client/python && \
        python3 -m pip install smg/grpc_servicer ; \
    else \
        echo "smg/ source not present in build context; keeping published tokenspeed-smg* wheels" ; \
    fi

# Sanity check WITHOUT importing the kernel: importing tokenspeed_kernel runs
# GPU detection (platform.py) and raises "requires an NVIDIA CUDA or AMD ROCm
# GPU" during `docker build`, which has no GPU. So check the installed
# distribution's version (must be the dev/source build, not the 0.1.3 wheel)
# and that the installed source exports the symbol the wheel lacked -- both via
# metadata/file inspection, no import. Fails the build here rather than at
# container startup if a wheel ever shadows the source again.
RUN python3 - <<'PY'
import importlib.metadata as md, pathlib, sys
ver = md.version("tokenspeed-kernel")
print("installed tokenspeed-kernel:", ver)
if ".dev" not in ver and "+git" not in ver:
    sys.exit(f"ERROR: installed a release wheel ({ver}), not the source build; "
             "a dependency reinstall shadowed the local kernel.")
files = md.files("tokenspeed-kernel")
init = next(f for f in files if f.as_posix().endswith("ops/communication/__init__.py"))
text = pathlib.Path(init.locate()).read_text()
if "allgather_dual_rmsnorm" not in text:
    sys.exit("ERROR: installed kernel lacks allgather_dual_rmsnorm.")
print("kernel source + symbol OK")
# Diffusion deps (H3/Music3) -- metadata only; do not import heavy stacks here.
for dist in ("diffusers", "av", "imageio-ffmpeg", "soundfile"):
    try:
        print(f"  {dist}:", md.version(dist))
    except md.PackageNotFoundError:
        sys.exit(f"ERROR: diffusion dep missing: {dist}")
print("diffusion deps OK")
import importlib.util
if importlib.util.find_spec("flash_attn") is None:
    sys.exit("ERROR: flash_attn (FA4 tokenspeed-fa4) missing")
print("flash_attn (FA4) present")
PY

CMD ["/bin/bash"]
